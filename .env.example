# better-auth
# 生成方式: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"
# 应用 base URL，本地开发用 http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"
# 额外信任的来源，逗号分隔。用于反向代理 / 多域名部署。
# 留空时仅信任 BETTER_AUTH_URL。
BETTER_AUTH_TRUSTED_ORIGINS=""

# Prisma / PostgreSQL
# 本地开发示例，按需替换 user / password / host / port / database
DATABASE_URL="postgresql://user:password@localhost:5432/nextjs-mui-starter?schema=public"

# 社交登录（可选）
# clientId 与 clientSecret 必须成对填写，否则该 provider 会被跳过，
# 登录/注册页也不会渲染对应按钮。
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# 邮件（尚未接入服务商）
# 密码重置在开发环境会把重置链接打印到服务端控制台；
# 生产环境未实现 src/lib/mail.ts 中的 sendMail 之前会直接报错，避免静默失效。
